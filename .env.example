# ─── Gmail SMTP (for sending contact form emails) ─────────────────────────────
# Use a Gmail account with an App Password (not your regular password).
# Enable 2-Step Verification and create an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=ornitech.contact@gmail.com
GMAIL_PASS=your-gmail-app-password

# ─── MongoDB (for storing form submissions) ──────────────────────────────────
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Then copy the connection string and replace <password> with your DB password.
MONGODB_URI=mongodb+srv://username:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
